<?xml version="1.0"?>
<DomainGroupSection>
  <!--IBC Group-->
  <DomainGroup id ="1"
               name="IBCBET"
               description="IBC Group"
               active="true">
    <Domain>
      <add before="http://www.zoneback.com/" after="https://mb.zoneback.com/ex-main/" active="true"></add>
      <add before="http://zoneback.com/" after="https://mb.zoneback.com/ex-main/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/IBC Group-->

  <!--I7 Group-->
  <DomainGroup id ="2"
               name="789Y"
               description="I7 Group"
               active="true">
    <Domain>
      <add before="http://www.halfluna.com/" after="https://mb.halfluna.com/ex-main/" active="true"></add>
      <add before="http://halfluna.com/" after="https://mb.halfluna.com/ex-main/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/I7 Group-->

  <!--Others-->
  <DomainGroup id ="999"
               name="Others"
               description="Others Group"
               active="true">
    <Domain>
      <add before="https://www.metaljazz.net/" after="http://mb.metaljazz.net/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/Others-->
</DomainGroupSection>