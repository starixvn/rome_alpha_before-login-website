<configuration>
  <configSections>
    <!--Fanex setting-->
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <!--Enterprise Library Distributor Service-->
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <!--End Fanex Setting-->
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase" />
    <sectionGroup name="AlphaSetting">
      <section name="UM" type="Fanex.Alpha.Before.Common.Configurations.UMSection, Fanex.Alpha.Before.Common, Version=1.0.0.0, Culture=neutral" />
      <section name="LoginTheme" type="Fanex.Alpha.Before.Customer.Configurations.LoginThemeSection, Fanex.Alpha.Before.Customer, Version=1.0.0.0, Culture=neutral" />
      <section name="AutomationTestSettings" type="Fanex.Alpha.Before.Customer.Configurations.AutomationTestSettings, Fanex.Alpha.Before.Customer, Version=1.0.0.0, Culture=neutral" />
      <section name="CommonSettings" type="Fanex.Alpha.Before.Customer.Configurations.AlphaCommonSection, Fanex.Alpha.Before.Common, Version=1.0.0.0, Culture=neutral" />
    </sectionGroup>
    <!--Limted Country Access Section-->
    <section name="LimtedCountryAccessSection" type="Fanex.Alpha.Before.Common.Configurations.LimtedCountryAccess.LimtedCountryAccessSection, Fanex.Alpha.Before.Common, Version=1.0.0.0, Culture=neutral" />
    <!--/Limted Country Access Section-->
    <!--domain group section-->
    <section name="DomainGroupSection" type="Fanex.Alpha.Before.Common.Configurations.Domain.DomainGroupSection, Fanex.Alpha.Before.Common" />
    <!--/domain group section-->
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>
  
  <AlphaSetting>
    <CommonSettings OfficeIPs=""
                    MaxTimesToAllowLoginFail="15"
                    BlockLoginMinutes="15"
					LoginFailTimeToStartUsingCaptcha="3"
                    PasswordMaxFailTimeForOneUser="5"
                    NoInteractionTimeInMinutes="5"/>

    <LoginTheme DefaultTheme="Default"
                StartDateShowEventTheme="2015/09/23 11:59:00"
                EndDateShowEventTheme="2015/09/27 11:59:00"
                EventTheme="MidAutumn2015"/>

    <AutomationTestSettings
      allowedIPs = "127.0.0.1"
      captcha = "88889999"
      allowusernamecontainwords="test"/>

  </AlphaSetting>
  <!--Limted Country Access Section-->
  <LimtedCountryAccessSection configSource="LimtedCountryAccessSection.config" />
  <!--/Limted Country Access Section-->
  <!--domain group section-->
  <DomainGroupSection configSource="DomainGroupSection.config" />
  <!--/domain group section-->
  <!--Fanex Setting-->
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data"
	  resourcePath="~/Configurations/pro.StoreProcedure"
	  enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://172.16.4.106/msmq/Private$/entlib" defaultCategory="Alpha-MBC-BF-UAT"/>
  <!--End Fanex Setting-->
  <!--Fanex-->
  <couchbase>
    <servers bucket="Alpha-BF-I1" bucketPassword="">
      <add uri="http://172.16.4.106:8091/pools/default"/>
    </servers>
  </couchbase>
  <!--Fanex-->
  <connectionStrings configSource="ConnectionStrings.config" />
  <appSettings file="Web.Setting.config">
    <add key="webpages:Version" value="2.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <customErrors mode="Off" defaultRedirect="~/Common/ErrorPage">
      <error statusCode="404" redirect="~/Views/Common/ErrorPage/404Error.htm" />
    </customErrors>
    <compilation debug="true" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Helpers, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Routing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Mvc, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.WebPages, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Razor, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="Microsoft.Web.Infrastructure, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <authentication mode="Forms">
      <forms loginUrl="~/Customer/SignIn" path="/" cookieless="UseDeviceProfile" name=".AGENTFORMSAUTH" protection="All" />
    </authentication>
    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>

    <sessionState mode="StateServer" timeout="5" stateConnectionString="tcpip=172.16.4.106:42424" />
    <machineKey validationKey="3361826F7AD281FDE08DDDB9C177A32CC037C2CD92F4F40D6952D512E095E7AF5B441EC73F2B51C0D26381832F03CB4A365AF362D27518F946BFF095CF2B1EAC"
    decryptionKey="D29F7B7D25EA318A997A8EE8DAEB008439A7C68E86B5F5DC" validation="SHA1" />
    <httpHandlers>
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-ISAPI-4.0_64bit" />
      <remove name="ExtensionlessUrlHandler-ISAPI-4.0_32bit" />
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition="" />
    </handlers>
    <staticContent>
      <clientCache cacheControlMode="UseExpires" httpExpires="Tue, 31 Dec 2030 00:00:00 GMT" />
    </staticContent>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
