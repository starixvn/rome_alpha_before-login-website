<?xml version="1.0"?>
<DomainGroupSection>
  <!--IBC Group-->
  <DomainGroup id ="1"
               name="IBC"
               description="IBC Group"
               active="true">
    <Domain>
      <add id="www.greysnow.com" before="https://www.greysnow.com/" after="http://mb.greysnow.com/" active="true"></add>
      <add id="greysnow.com" before="https://greysnow.com/" after="http://mb.greysnow.com/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/IBC Group-->

  <!--I7 Group-->
  <DomainGroup id ="2"
               name="I7"
               description="I7 Group"
               active="true">
    <Domain>
      <add id="www.a77ag.com" before="https://www.a77ag.com/" after="http://mb.a77ag.com/" active="true"></add>
      <add id="a77ag.com" before="https://a77ag.com/" after="http://mb.a77ag.com/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/I7 Group-->

  <!--Others-->
  <DomainGroup id ="999"
               name="Others"
               description="Others Group"
               active="true">
    <Domain>
      <add id="www.metaljazz.net" before="https://www.metaljazz.net/" after="http://mb.metaljazz.net/" active="true"></add>
