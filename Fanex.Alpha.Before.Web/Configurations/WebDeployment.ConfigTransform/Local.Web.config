  </location>
  <location path="Areas">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Common/Offline">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Detecas">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" 
              EnableCheckUM="false" 
              EnableUnscheduledUM="false" 
              UMFrom="03:00" UMTo="04:00" 
              SiteId="2000" 
              UMPageUrl="~/UserLogin/Common/Offline">
    <AllowedIPs AllowAll="true">
      <add Value="10.19.10.54" />
      <!--Exact IP-->
      <add From="10.19.10.100" To="10.19.10.200" />
      <!--IP Range-->
    </AllowedIPs>
  </ONEbook.UM>
