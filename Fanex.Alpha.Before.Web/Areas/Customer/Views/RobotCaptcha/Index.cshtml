@using CommonAppSetting = Fanex.Alpha.Before.Common.Configurations.AppSetting
@{
    Layout = null;
    var version = CommonAppSetting.Version;
    var errorMessage = (string)TempData["ErrorMessage"];
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Robot Captcha</title>
    <link rel="stylesheet" href="@Url.Content("~/assets/bundles/robotcaptcha.min.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/assets/styles/alpha.slider-captcha.css?v=" + version)" />
</head>
<body>
    <div class="wrapper">
        <form method="post" id="captcha-form">
            <div id="captcha" name="token"></div>
        </form>
    </div>
    <script src="~/assets/scripts/alpha.slider-captcha.js?ver=@version" type="text/javascript"></script>
    <script>
        window.scInstance = sliderCaptcha('captcha', {
            lang: "@Fanex.Alpha.Before.Common.Configurations.AppSession.Language",
            baseUri: "@Url.Content("~")",
            callback: function () {
                document.getElementById("captcha-form").submit();
                this.cleanup();
            }
        });
    </script>
    @{ Html.RenderPartial("~/Views/Shared/GoogleAnalytic.cshtml", CommonAppSetting.GoogleAnalyticId); }
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
</body>
</html>