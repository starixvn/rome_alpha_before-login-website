@using CaptchaMvc.HtmlHelpers;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.Alpha.Before.Customer.Models.SignInResult

    <center>
        <div class="content">
            <div id="textTitle" class="textTitle_en"></div>
            <div class="wrapper">
                <div class="inputContainer">
                    <table>
                        <tr>
                            <td class="header">
                                <div class="title" id="divTitle">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="row">
                                 <div class="language-box">
                                    <div id="ddLanguage" class="language-select">
                                    </div>
                                    <input type="hidden" value="en-US" id="hidLanguage" name="hidLanguage" />
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="row extra-row">
                                <i class="icon-txt icon-user"></i>
                                <input type="text" id="txtUserName" name="txtUserName" class="custom-textbox"
                                    placeholder="Username" tabindex="1" autocomplete="off" maxlength="50" />
                            </td>
                        </tr>
                        <tr>
                            <td class="row extra-row">
                                <i class="icon-txt icon-lock"></i>
                                <input type="text" id="txtPassWord" name="txtPassWord" class="custom-textbox"
                                    placeholder="Password" tabindex="2" autocomplete="off" />
                            </td>
                        </tr>
                        <tr>
                            <td class="row custom-row">
                                <label class="showPass">
                                    <input type="checkbox" id="chbShowPass" class="checkShowPass" onclick="Sphinx.Login.showPassword(this)"
                                        tabindex="3" />
                                    <span id="lbShowPass">Show password</span>
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td class="" id="captcha">
                                @if (ViewBag.ShowReCaptcha == true)
                                {
                                    @Html.Captcha(4, "~/Areas/Captcha/Views/SylouCaptcha/CaptchaEventPartialView.cshtml", ViewData)
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="row">
                                <input type="button" class="btnLogin" id="btnLogin" value="Login" onclick="return Sphinx.Login.doLogin();"
                                    tabindex="5" />
                            </td>
                        </tr>
                    </table>
                    <div class="errorMessage" errCode="@Model.ErrCode" id="errmsg">@Model.ErrMsg</div>
                </div>
            </div>
            <div id="divPopupMobileVersion" style="color: #000; font-size: 14px; padding-top: 480px;">@(Model.IsChangedPassword ? @Model.ChangedPasswordTime : "")
            </div>
        </div>   
    </center>