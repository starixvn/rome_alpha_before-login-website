@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.Alpha.Before.Customer.Models.SignInResult

    <center>
        <div class="content">
            <div class="wrapper">
                <div class="inputContainer">
                <div class="header">                    
                    <div class="title" id="divTitle"></div>
                    <div class="language-box">
                         <div id="ddLanguage" class="language-select">
                        </div>
                        <input type="hidden" value="en-US" id="hidLanguage" name="hidLanguage" />
                    </div>
                </div>
                <table>
                    <tr>
                        <td class="row">
                            <input type="text" id="txtUserName" name="txtUserName" class="custom-textbox username"
                                placeholder="Username" tabindex="1" autocomplete="off" />
                        </td>
                    </tr>
                    <tr>
                        <td class="row">
                            <input type="text" id="txtPassWord" name="txtPassWord" class="custom-textbox password"
                                placeholder="Password" tabindex="2" autocomplete="off" />                                    
                        </td>
                    </tr>
                    <tr>
                        <td class="row custom-row">
                            <label class="showPass">
                                <input type="checkbox" id="chbShowPass" class="checkShowPass" onclick="Sphinx.Login.showPassword(this)" tabindex="3" />
                                <span id="lbShowPass">Show password</span>
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="row custom-row">
                            <input type="text" id="txtCaptcha" name="txtCaptcha" class="custom-textbox inputCaptcha" maxlength="4" placeholder="Validation"
                                tabindex="4" />
                            <div class="codeCaptcha">
                                <img width="66" height="27" id="imgCode" src="@Url.Content("~/Customer/SignIn/NewCaptcha")" style="cursor:pointer" alt="" onclick="return Sphinx.Login.getValidateImage();"/>
                            </div>
                            <div class="refreshCont"><span class="refreshCode" onclick="return Sphinx.Login.getValidateImage();"></span></div>
                             <input type="button" class="btnLogin" id="btnLogin" value="Login" onclick="return Sphinx.Login.doLogin();" tabindex="5" />
                        </td>
                    </tr>
                </table>
                
                <div class="errorMessage" errCode="@Model.ErrCode" id="errmsg">@Model.ErrMsg</div>
                
                </div>
                <div class="shadow"></div>   
            </div>  
            <div id="divPopupMobileVersion" style="color:#000; font-size: 14px; padding-top: 20px;">@(Model.IsChangedPassword ? @Model.ChangedPasswordTime : "")
            </div>
        </div>        
    </center>