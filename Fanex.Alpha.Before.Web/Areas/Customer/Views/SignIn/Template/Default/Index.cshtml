@using CaptchaMvc.HtmlHelpers;

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Fanex.Alpha.Before.Customer.Models.SignInResult

@section styles
{
    <link href="~/assets/bundles/login.min.css?ver=@AppSetting.Version" rel="stylesheet" />
}

<div class="box-lang">
    <div class="dropdown">
        <span class="btn dropdown-toggle" type="button" id="langList" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
            <span class="flag" id="flag"></span>
            <span id="lblLanguage">English</span> 
            <span class="caret"></span>
            <input type="hidden" value="en-US" id="hidLanguage" name="hidLanguage">
        </span>
        <ul class="dropdown-menu" aria-labelledby="langList" id="language-ddl">
            <li><a href="javascript:void(0);"><span class="flag flag-en" data-language-code="en-US"></span>English</a></li>
            <li><a href="javascript:void(0);"><span class="flag flag-cn" data-language-code="zh-CN"></span>繁體中文</a></li>
            <li><a href="javascript:void(0);"><span class="flag flag-tw" data-language-code="zh-TW"></span>简体中文</a></li>
            <li><a href="javascript:void(0);"><span class="flag flag-jp" data-language-code="ja-JP"></span>日本語</a></li>
            <li><a href="javascript:void(0);"><span class="flag flag-th" data-language-code="th-TH"></span>ภาษาไทย</a></li>
            <li><a href="javascript:void(0);"><span class="flag flag-kr" data-language-code="ko-KR"></span>한국어</a></li>
            <li><a href="javascript:void(0);"><span class="flag flag-vn" data-language-code="vi-VN"></span>Tiếng Việt</a></li>
        </ul>
    </div>
</div>

<h1 class="title login-text">Login</h1>

<div class="rowlg msg-error" errCode="@Model.ErrCode" id="errmsg">@Model.ErrMsg</div>

<div class="rowlg">
    <input type="text" class="txt" placeholder="Username"  id="txtUserName" name="txtUserName">
    <i class="icon-user"></i>
</div>

<div class="rowlg">
    <input type="password" class="txt" placeholder="Password" id="txtPassWord" name="txtPassWord" >
    <i class="icon-lock"></i>
</div>

<div class="rowlg checkbox">
    <label>
        <input name="chb-showpass" type="checkbox" id="chbShowPass" /> 
        <span id="lbShowPass">Show password</span>
    </label>
</div>
@Html.Captcha(4, "~/Areas/Captcha/Views/SylouCaptcha/CaptchaPartialView.cshtml", ViewData)

@if (ViewBag.ShowReCaptcha == true)
{
    @Html.Captcha(4, "~/Areas/Captcha/Views/SylouCaptcha/CaptchaPartialView.cshtml", ViewData)
}
<div class="list-button">
    <input type="button" class="btnLogin" value="Login" id="btnLogin"/>
    @*<input type="button" class="btnLogin" value="Login" id="btnLogin" disabled />*@
</div>

