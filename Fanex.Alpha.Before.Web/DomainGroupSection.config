               name="IBCBET"
               description="IBC Group"
               active="true"
               sitekey="6LdF3sQUAAAAAIT-Uyb9hmOsf8dzlrJhYETcViRd"
               secretkey="6LdF3sQUAAAAABNWDCiAuMiBwgwBh-0RjFPjF2q-"
               proxy="http://10.18.200.41:3128">
    <Domain>
      <add before="http://localhost:804/" after="http://localhost:805/ex-main/" active="true" />
      <add before="http://localhost:8081/" after="http://localhost:8888/ex-main/" active="true" />
