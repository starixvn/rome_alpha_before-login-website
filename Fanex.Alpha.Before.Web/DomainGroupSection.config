<?xml version="1.0"?>
<DomainGroupSection>
  <!--IBC Group-->
  <!--ID must equal with before url domain-->
  <!--Copy IBC keys-->
  <!--After path must end with "/"-->
  <DomainGroup id ="1"
               name="IBCBET"
               description="IBC Group"
               active="true">
    <Domain>
      <add before="http://localhost:8081/" after="http://localhost:8888/ex-main/" active="true"></add>
      <add before="http://localhost:9004/" after="http://localhost:9005/ex-main/" active="true"></add>
    </Domain>
  </DomainGroup>
  <!--/IBC Group-->
</DomainGroupSection>