<?xml version="1.0"?>
<DomainGroupSection>
  <!--IBC Group-->
  <!--ID must equal with before url domain-->
  <!--Copy IBC keys-->
  <!--After path must end with "/"-->
  <DomainGroup id ="1"
               name="IBCBET"
               description="IBC Group"
               active="true">
    <Domain>
      <add before="http://localhost:804/" after="http://localhost:805/ex-main/" active="true" />
      <add before="http://10.19.10.34:804/" after="http://10.19.10.34:805/ex-main/" active="true" />
      <add before="http://localhost:6789/" after="http://localhost:6789/ex-main/" active="true" />
      <add before="http://localhost:8887/" after="http://localhost:8888/ex-main/" active="true" />
    </Domain>
  </DomainGroup>
  <!--/IBC Group-->
</DomainGroupSection>