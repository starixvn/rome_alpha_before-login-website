<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="Etag" />
        <remove name="Expires" />
        <remove name="Last-Modified" />
        <remove name="Date" />
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="no-cache,no-store" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <system.web>
    <authorization>
      <allow users="*"/>
    </authorization>

  </system.web>
</configuration>