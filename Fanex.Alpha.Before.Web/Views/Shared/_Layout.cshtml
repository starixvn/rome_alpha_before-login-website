@using CommonAppSetting = Fanex.Alpha.Before.Common.Configurations.AppSetting
@model Fanex.Alpha.Before.Customer.Models.SignInResult
<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link href="~/assets/styles/vendors-extensions/login/bootstrap-ex.min.css?ver=@CommonAppSetting.Version" rel="stylesheet" />
    @RenderSection("styles", false)
</head>
<body>

    <div id="divLoading" style="display: none">
        <h2>
            Loading... please wait
        </h2>
    </div>

    <div id="mainholder" class="block-login">
        <form id="formLogin" class="form-login" action="@Url.Content("~/Customer/SignIn/Index")" method="POST" autocomplete="off">
            @RenderBody()
            <input name="code" id="code" type="hidden" value="@Model.Captcha" />
            <input id="detecas-analysis" name="detecas-analysis" value="{}" type="hidden" />
        </form>
    </div>
    <div class="block-info">
        Your password was last changed on 8/23/2016 5:26:48 AM. Please contact to CSD at once if you still cannot login.
    </div>

    <script src="~/assets/bundles/libs.min.js?ver=@CommonAppSetting.Version"></script>
    <script src="~/assets/bundles/login.min.js?ver=@CommonAppSetting.Version" type="text/javascript"></script>

    <script language="javascript" type="text/javascript">
        var detecasAnalysis = document.getElementById("detecas-analysis");
        detecasAnalysis ? (detecasAnalysis.value = '{"startTime":1446686616296,"version":"0.0.0","enable":true}') : false;

        var _page = {
            errCode: 0,
            errMsg: '',
            language: 0,
            ip: '',
            __utms: '',
            domain: '',
            captcha: '',
            fpsActivator: ''
        };

        _page.errCode = @Model.ErrCode;
        _page.errMsg = '@Html.Raw("@Model.ErrMsg")';
        _page.language = @Model.Language;
        _page.ip = '@Model.Ip';
        _page.__utms = '@Model.UTMS';
        _page.domain = '@Model.Domain';
        _page.captcha = '@Model.Captcha';
        _page.fpsActivator = '@CommonAppSetting.FpsActivator';

        window.rootUrl = '@Url.Content("~")';


        if(parseInt(_page.errCode) === -1) {
            $('#mainholder').css('display', 'none');
            $('#divLoading').css('display', 'block');
            $("body").css("background", "none");
            window.location.href = 'Flow';
        }

        !function(e, t, a, c, n) {
            var s = t.createElement(a),
            o = t.getElementsByTagName(c)[0];
            s.async = true, s.defer = true, s.src = n, o.appendChild(s)
        }(window, document, "script", "body", "@CommonAppSetting.FpsActivator");

    </script>

    @RenderSection("scripts", false)
</body>
</html>
