@using CommonAppSetting = Fanex.Alpha.Before.Common.Configurations.AppSetting
@model Fanex.Alpha.Before.Customer.Models.SignInResult
<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link href="~/assets/styles/vendors-extensions/login/bootstrap-ex.min.css?ver=@CommonAppSetting.Version" rel="stylesheet" />

    @RenderSection("styles", false)

</head>
<body>

    <div id="divLoading" style="display: none">
        <h2>
            Loading... please wait
        </h2>
    </div>

    <div id="mainholder" class="block-login">
        <form id="formLogin" class="form-login" action="@Url.Content("~/Customer/SignIn/Index")" method="POST" autocomplete="off">
            @RenderBody()
            <input name="code" id="code" type="hidden" value="@Model.Captcha" />
            <input id="detecas-analysis" name="detecas-analysis" value="{}" type="hidden" />
        </form>
    </div>

    @if (Model.IsChangedPassword)
    {
        <div class="block-info">
            @Model.ChangedPasswordTime
        </div>
    }

    @Html.Hidden("ModelErrCode", Model.ErrCode)
    @Html.Hidden("ModelErrMsg", Html.Raw(Model.ErrMsg))
    @Html.Hidden("ModelLanguage", Model.Language)
    @Html.Hidden("ModelIp", Model.Ip)
    @Html.Hidden("ModelUTMS", Model.UTMS)
    @Html.Hidden("ModelDomain", Model.Domain)
    @Html.Hidden("ModelCaptcha", Model.Captcha)
    @Html.Hidden("CommonAppSettingFpsActivator", CommonAppSetting.FpsActivator)
    @Html.Hidden("RootUrl", Url.Content("~"))

    <script src="~/assets/bundles/login.min.js?ver=@CommonAppSetting.Version" type="text/javascript"></script>

    @RenderSection("scripts", false)

</body>
</html>
