<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fanex.Alpha.Before\Fanex.Alpha.Before.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Alpha.SliderCaptcha.AspNetCore" Version="1.0.0-beta5" />
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.2.2" />
    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.0.0" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
    <PackageReference Include="Fanex.Logging.RabbitMQ" Version="1.0.1" />
    <PackageReference Include="Fanex.Logging.Sentry" Version="1.0.6" />
    <PackageReference Include="ONEbook.UM.AspNetCore" Version="3.1.0" />
    <PackageReference Include="ONEbook.UM.AspNetCore.Filters" Version="3.1.0-beta12" />
    <PackageReference Include="ONEbook.UM.Transport" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\**\*;">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>