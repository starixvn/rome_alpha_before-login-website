@using CommonAppSetting = Fanex.Alpha.Before.Common.Configurations.AppSetting

@model Fanex.Alpha.Before.Customer.Models.SignInResult
@{
    Layout = null;
}

@Html.Hidden("ModelErrCode", Model.ErrCode)
@Html.Hidden("ModelErrMsg", Html.Raw(Model.ErrMsg))
@Html.Hidden("ModelLanguage", Model.Language)
@Html.Hidden("ModelIp", Model.Ip)
@Html.Hidden("ModelUTMS", Model.UTMS)
@Html.Hidden("ModelDomain", Model.Domain)
@Html.Hidden("ModelCaptcha", Model.Captcha)
@Html.Hidden("CommonAppSettingFpsActivator", CommonAppSetting.FpsActivator)
@Html.Hidden("RootUrl", Url.Content("~"))
<style>
    .grecaptcha-badge {
        display: none !important;
    }
</style>
<script type="text/javascript">
    var _page = {
        errCode: 0,
        errMsg: '',
        language: 0,
        ip: '',
        __utms: '',
        domain: '',
        captcha: '',
        fpsActivator: ''
    };

    _page.errCode = document.getElementById("ModelErrCode").value;
    _page.errMsg = document.getElementById("ModelErrMsg").value;
    _page.language = document.getElementById("ModelLanguage").value;
    _page.ip = document.getElementById("ModelIp").value;
    _page.__utms = document.getElementById("ModelUTMS").value;
    _page.domain = document.getElementById("ModelDomain").value;
    _page.captcha = document.getElementById("ModelCaptcha").value;
    _page.fpsActivator = document.getElementById("CommonAppSettingFpsActivator").value;

    window.rootUrl = document.getElementById("RootUrl").value;
</script>
@if (Model.GoogleReCaptcha != null && Model.GoogleReCaptcha.IsEnable)
{
    <script>
        var googleV3key = '@Model.GoogleReCaptcha.SiteKey';
        !function (e, t, a, c, n) {
            var s = t.createElement(a),
               o = t.getElementsByTagName(a)[0];
            s.async = true, s.src = n, o.appendChild(s)
        }
        (window, document, 'script', 'body', 'https://www.google.com/recaptcha/api.js?render=' + googleV3key);

        try {
            var analysis = document.getElementById("detecas-analysis");
            if (analysis) analysis.value = "js-enabled" + String.fromCharCode(64) + (new Date()).getTime();
        }
        catch (err) { };
    </script>
}

@if (CommonAppSetting.IsEnableFPS)
{
<script src="~/assets/scripts/login/fps.js?ver=@CommonAppSetting.Version" type="text/javascript"></script>
}

@if (Model.GoogleReCaptcha != null && Model.GoogleReCaptcha.IsEnable)
{
    <script src="~/assets/bundles/captchav3.js?ver=@CommonAppSetting.Version" type="text/javascript"></script>
}