@model UnderMaintenanceModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>
    <title>UM Page</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=0.7, user-scalable=yes">
    <link href="~/assets/bundles/themes/um@(ViewData["DarkModeName"]).min.css" rel="stylesheet" />
</head>

<body>
    <div class="container">
        <svg id="wrap" width="200" height="200" viewbox="0 0 300 300">
            <!-- background -->
            <svg>
                <circle cx="150" cy="150" r="125" style="stroke: #f0cdd0; stroke-width:18; fill:transparent" />
                <circle cx="150" cy="150" r="110" style="fill:#67151b" />
                <path
                    style="stroke: #67151b; stroke-dasharray:820; stroke-dashoffset:820; stroke-width:18; fill:transparent"
                    d="M150,150 m0,-125 a 125,125 0 0,1 0,250 a 125,125 0 0,1 0,-250">
                    <animate attributeName="stroke-dashoffset" dur="6s" to="-820" repeatCount="indefinite" />
                </path>
            </svg>

            <!-- image -->
            <svg>
                <path id="hourglass" d="M150,150 C60,85 240,85 150,150 C60,215 240,215 150,150 Z"
                    style="stroke: white; stroke-width:5; fill:white;" />

                <path id="frame"
                    d="M100,97 L200, 97 M100,203 L200,203 M110,97 L110,142 M110,158 L110,200 M190,97 L190,142 M190,158 L190,200 M110,150 L110,150 M190,150 L190,150"
                    style="stroke:#f0cdd0; stroke-width:6; stroke-linecap:round" />

                <animateTransform xlink:href="#frame" attributeName="transform" type="rotate" begin="0s" dur="3s"
                    values="0 150 150; 0 150 150; 180 150 150" keyTimes="0; 0.8; 1" repeatCount="indefinite" />
                <animateTransform xlink:href="#hourglass" attributeName="transform" type="rotate" begin="0s" dur="3s"
                    values="0 150 150; 0 150 150; 180 150 150" keyTimes="0; 0.8; 1" repeatCount="indefinite" />
            </svg>
            <!-- sand -->
            <svg>
                <!-- upper part -->
                <polygon id="upper" points="120,125 180,125 150,147" style="fill:#67151b;">
                    <animate attributeName="points" dur="3s" keyTimes="0; 0.8; 1"
                        values="120,125 180,125 150,147; 150,150 150,150 150,150; 150,150 150,150 150,150"
                        repeatCount="indefinite" />
                </polygon>

                <!-- falling sand -->
                <path id="line" stroke-linecap="round" stroke-dasharray="1,4" stroke-dashoffset="200.00"
                    stroke="#67151b" stroke-width="2" d="M150,150 L150,198">
                    <!-- running sand -->
                    <animate attributeName="stroke-dashoffset" dur="3s" to="1.00" repeatCount="indefinite" />
                    <!-- emptied upper -->
                    <animate attributeName="d" dur="3s" to="M150,195 L150,195"
                        values="M150,150 L150,198; M150,150 L150,198; M150,198 L150,198; M150,195 L150,195"
                        keyTimes="0; 0.65; 0.9; 1" repeatCount="indefinite" />
                    <!-- last drop -->
                    <animate attributeName="stroke" dur="3s" keyTimes="0; 0.65; 0.8; 1"
                        values="#67151b;#67151b;transparent;transparent" to="transparent" repeatCount="indefinite" />
                </path>

                <!-- lower part -->
                <g id="lower">
                    <path d="M150,180 L180,190 A28,10 0 1,1 120,190 L150,180 Z"
                        style="stroke: transparent; stroke-width:5; fill:#67151b;">
                        <animateTransform attributeName="transform" type="translate" keyTimes="0; 0.65; 1"
                            values="0 15; 0 0; 0 0" dur="3s" repeatCount="indefinite" />
                    </path>
                    <animateTransform xlink:href="#lower" attributeName="transform" type="rotate" begin="0s" dur="3s"
                        values="0 150 150; 0 150 150; 180 150 150" keyTimes="0; 0.8; 1" repeatCount="indefinite" />
                </g>

                <!-- lower overlay - hourglass -->
                <path d="M150,150 C60,85 240,85 150,150 C60,215 240,215 150,150 Z"
                    style="stroke: white; stroke-width:5; fill:transparent;">
                    <animateTransform attributeName="transform" type="rotate" begin="0s" dur="3s"
                        values="0 150 150; 0 150 150; 180 150 150" keyTimes="0; 0.8; 1" repeatCount="indefinite" />
                </path>

                <!-- lower overlay - frame -->
                <path id="frame" d="M100,97 L200, 97 M100,203 L200,203"
                    style="stroke:#f0cdd0; stroke-width:6; stroke-linecap:round">
                    <animateTransform attributeName="transform" type="rotate" begin="0s" dur="3s"
                        values="0 150 150; 0 150 150; 180 150 150" keyTimes="0; 0.8; 1" repeatCount="indefinite" />
                </path>
            </svg>

        </svg>
        <div class="title">Under Maintenance</div>
        <div class="caption">
            <p>We are having regular server maintenance.</p>
            <p>The website is currently unavailable <span class="time"> from @Model.FromTimeText until @Model.ToTimeText
                    (GMT +8).</span></p>
            <p>Please come back later.</p>
        </div>
        <div class="caption">
            <p>本公司將於 <span class="time"> @Model.FromTimeText 至 @Model.ToTimeText (GMT +8) </span>對服務器進行例行維護。</p>
            <p>期間所有的網頁將無法登入。</p>
            <p>請您稍候再來。</p>
        </div>
    </div>
    @if (Model.ShowCountDown())
    {
        <script type="text/javascript">
            setTimeout(function () {
                window.location.href = window.location.href;
            }, @Model.CountdownTime.TotalMilliseconds);
        </script>
    }
</body>

</html>