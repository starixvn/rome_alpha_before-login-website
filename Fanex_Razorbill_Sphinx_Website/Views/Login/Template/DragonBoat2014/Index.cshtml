@{
    Layout="~/Views/Shared/_Layout.cshtml";
}
<div class="main">
    <div class="header">
    </div>
    <center>
    <div class="content">
       <div class="login">
                <div class="wrapper">
                    <div class="inputContainer">
                        <table>
                            <tr>
                                <td class="row">
                                    <div id="ddLanguage" class="language-select">
                                    </div>
                                    <input type="hidden" value="en-US" id="hidLanguage" name="hidLanguage" />
                                </td>
                            </tr>
                            <tr>
                                <td class="row">
                                    <input type="text" id="txtUserName" name="txtUserName" class="custom-textbox username"
                                        placeholder="Username" tabindex="1" />
                                </td>
                            </tr>
                            <tr>
                                <td class="row">
                                    <input type="text" id="txtPassWord" name="txtPassWord" class="custom-textbox password"
                                        placeholder="Password" tabindex="2" />
                                    <label class="showPass">
                                        <input type="checkbox" id="chbShowPass" class="checkShowPass" onclick="Sphinx.Login.showPassword(this)" tabindex="3" /><span
                                            id="lbShowPass">Show password</span>
                                    </label>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <input type="text" id="txtCaptcha" name="txtCaptcha" class="inputText inputCaptcha" maxlength="4"
                                        tabindex="4" />
                                    <div class="codeCaptcha">
                                        <img width="66" height="25" src="@Url.Content("~/Login/GetNewCaptcha")" id="imgCode" style="cursor:pointer" alt="" onclick="return Sphinx.Login.getValidateImage();"/>
                                    </div>
                                    <div>
                                        <i class="refreshCode" onclick="return Sphinx.Login.getValidateImage();"></i>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <input type="button" class="btnLogin" id="btnLogin" value="Login" onclick="return Sphinx.Login.doLogin();" tabindex="5" />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <i id="imgLoading" class="loading" style="display: none"></i>
                                </td>
                            </tr>
                        </table>
                    </div>
                   
                    <div class="errorMessage" errCode="@Model.ErrMsg" id="errmsg">@Model.ErrMsg
                    </div>
                </div>
                
            </div>
             <div class="bestview"></div>
             <div id="textTitle" class="titleText">
            </div>
    </div>
    </center>
</div>