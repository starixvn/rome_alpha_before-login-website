@model Fanex.Razorbill.Sphinx.Service.UserLogin.Models.LoginResult
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Sign In</title>
    <link href="~/Views/Login/Template/Olempic/Styles/SignIn.css" rel="stylesheet"
        type="text/css" />
</head>
<body>
    <div id="table_main">
        <center>
            <div id="center">
                @using (Html.BeginForm())
                {
                    <table class="mainBox" border="0" align="right" cellpadding="0" cellspacing="0">
                        <tr>
                            <td style="width: 360px; height: 26px">
                            </td>
                            <td>
                            </td>
                            <td valign="top">
                                <div id="lanEnUS" onclick="SelectLanguage(0)" title="English">
                                </div>
                                <div id="lanZhTW" onclick="SelectLanguage(1)" title="繁體中文">
                                </div>
                                <div id="lanZhCN" onclick="SelectLanguage(4)" title="简体中文">
                                </div>
                                <div id="lanJaJP" onclick="SelectLanguage(2)" title="日本語">
                                </div>
                                <div id="lanThTH" onclick="SelectLanguage(3)" title="ภาษาไทย">
                                </div>
                                <div id="lanKoKR" onclick="SelectLanguage(5)" title="한국어">
                                </div>
                                <div id="lanViVN" onclick="SelectLanguage(6)" title="Tiếng Việt">
                                </div>
                                <input type="hidden" value="en-US" id="hidLanguage" name="hidLanguage" />
                            </td>
                        </tr>
                        <tr>
                            <td class="line" colspan="3">
                            </td>
                        </tr>
                        <tr>
                            <td>
                            </td>
                            <td class="imgSignIn">
                            </td>
                            <td height="25" align="left" valign="middle">
                                <table width="100%" border="0" cellpadding="3" cellspacing="0">
                                    <tr>
                                        <td class="mainErrMsg" align="left" valign="top" colspan="2">
                                            <div id="errmsg" class="errmsg">@Model.ErrMsg
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">
                                            <span id="spnUserName"></span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">
                                            <input name="txtUserName" type="text" id="txtUserName" value="@Model.Username" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" style="padding-top: 15px">
                                            <span id="spnPassWord"></span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">
                                            <input name="txtPassWord" id="txtPassWord" type="password" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width: 80px; padding-top: 15px">
                                            <span id="spnCaptcha" style="font-weight: bold;"></span>
                                            <input id="txtCaptcha" name="txtCaptcha" type="text" style="width: 70px;" maxlength="4"
                                                autocomplete="off" onkeydown="DoEnter(event, 'DoLogin()')" />
                                        </td>
                                        <td align="left" valign="middle" onclick="return GetValidateImage();" style="padding-top: 20px">
                                            <img height="32" src="Login/GetNewCaptcha" id="imgCode" alt="" />&nbsp;&nbsp;&nbsp;
                                            <img height="30" id="refreshIcon" onclick="return GetValidateImage();" alt="Refresh"
                                                src="~/Views/Login/Template/Olempic/Styles/Images/refresh-icon.png" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" style="padding-top: 15px">
                                            <input id="btnLogin" type="submit" class="buttonsite" value="Login" onclick="return DoLogin()" />
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td align="right" valign="middle">
                            </td>
                            <td align="right" valign="middle">
                                <div id="divBrowser" class="text_brow">
                                    Recommended Browsers:</div>
                            </td>
                            <td>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" align="center" valign="middle">
                            </td>
                        </tr>
                    </table>
                }
                <p>
                    &nbsp;</p>
            </div>
        </center>
    </div>
    <!--PopupMobileVersion-->
    <div id="divPopupMobileVersion" style="">@(Model.IsChangedPassword ? @Model.ChangedPasswordTime : "")
                                             
    </div>
    <!--/PopupMobileVersion-->
</body>
<script src="~/Scripts/Core.js?ver=@Fanex.Razorbill.Sphinx.Core.Configurations.WebSettings.AppVersion" type="text/javascript"></script>
<script src="~/Views/Login/Template/Olempic/Js/SignIn.js?ver=@Fanex.Razorbill.Sphinx.Core.Configurations.WebSettings.AppVersion" type="text/javascript"></script>
<script language="javascript" type="text/javascript">
    var _page = {
        errCode: 0,
        errMsg: '',
        language: 0,
        ip: '',
        __utms: '',
        domain: '',
        captcha: ''
    };

    _page.errCode = @Model.ErrCode;
    _page.errMsg = '@Model.ErrMsg';
    _page.language = @Model.Language;
    _page.ip = '@Model.Ip';
    _page.__utms = '@Model.UTMS';
    _page.domain = '@Model.Domain';
    _page.captcha = '@Model.Captcha';

</script>
</html>
