@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 @using (Html.BeginForm())
 {
    <div class="container">
        <div class="row-fluid header">
            <div class="span12 login-panel">
                <div class="row-fluid">
                    <div class="span3 custom-span3-empty">
                    </div>
                    <div class="span2 img-panel">
                    </div>
                    <div class="span4 login-panel-inner">
                        <div class="row-fluid login-elements">
                            <div class="span2">
                            </div>
                            <div class="span8">
                                <div class="row-fluid">
                                    <div class="span8 language-select dropdown">
                                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                                <i id="flag" class="flag-en"></i>
                                                <span id="lbLanguage">English</span><b class="caret custom-caret"></b>
                                            </a>
                                        <ul class="dropdown-menu">
                                            <li><a href="javascript:Sphinx.Login.setLanguague('en-US')"><i class="flag-en"></i>English</a></li>
                                            <li><a href="javascript:Sphinx.Login.setLanguague('zh-CN')"><i class="flag-cn"></i>Chinese</a></li>
                                            <li><a href="javascript:Sphinx.Login.setLanguague('ko-KR')"><i class="flag-kr"></i>Korean</a></li>
                                            <li><a href="javascript:Sphinx.Login.setLanguague('zh-TW')"><i class="flag-tw"></i>Taiwan</a></li>
                                            <li><a href="javascript:Sphinx.Login.setLanguague('vi-VN')"><i class="flag-vn"></i>Vietnamese</a></li>
                                            <li><a href="javascript:Sphinx.Login.setLanguague('ja-JP')"><i class="flag-jp"></i>Japanese</a></li>
                                            <li><a href="javascript:Sphinx.Login.setLanguague('th-TH')"><i class="flag-th"></i>Thailand</a></li>
                                            <input type="hidden" value="en-US" id="hidLanguage" name="hidLanguage" />
                                        </ul>
                                    </div>
                                    <div class="span12">
                                        <input class="custom-textbox" type="text" placeholder="UserName" id="txtUserName"
                                            name="txtUserName">
                                    </div>
                                    <div class="span12">
                                        <input class="custom-textbox" type="text" placeholder="PassWord" id="txtPassWord"
                                            name="txtPassWord" />
                                    </div>
                                    <div class="span12 showPassSection">
                                        <label class="showPass">
                                            <input type="checkbox" id="chbShowPass" class="checkShowPass" onclick="Sphinx.Login.showPassword(this)" /><span
                                                id="lbShowPass">Show password</span></label>
                                    </div>
                                    <div class="span12 span12-verified">
                                        <div class="row-fluid">
                                            <div class="span4 span4-verified">
                                                <input class="custom-textbox" type="text" id="txtCaptcha" name="txtCaptcha" onkeydown="Sphinx.Login.doEnter(event,'Sphinx.Login.doLogin()')" />
                                            </div>
                                            <div class="span4 captimg">
                                                <img height="32" src="@Url.Content("~/Login/GetNewCaptcha")" id="imgCode" alt="" />
                                            </div>
                                            <div class="span2">
                                                <i class="iconRefresh" id="refreshIcon" onclick="return Sphinx.Login.getValidateImage();" ></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="span4">
                                        <input type="submit" class="btnLogin" value="LOG IN" onclick="return Sphinx.Login.doLogin();" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row-fluid">
                            <div class="span2">
                            </div>
                            <div class="span10 errorMessage" errCode="@Model.ErrMsg" id="errmsg">@Model.ErrMsg
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="span12">
                <div class="row-fluid">
                    <div class="span3 custom-span3-empty">
                    </div>
                    <div id="textTitle" class="span6 textTitle textTitle_en">
                    </div>
                </div>
            </div>
        </div>
    </div>
 }
<div id="divPopupMobileVersion" style="color:#000; text-align: center">@(Model.IsChangedPassword ? @Model.ChangedPasswordTime : "")
</div>


