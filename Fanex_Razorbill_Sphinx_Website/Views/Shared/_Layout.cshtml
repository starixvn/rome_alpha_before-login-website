@using Fanex.Razorbill.Sphinx.Core.Configurations
@model Fanex.Razorbill.Sphinx.Service.UserLogin.Models.LoginResult
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta charset="utf-8" />
    <meta name="Login" content="width=device-width" />
    <title>Sign In</title>
    
    <link href="~/Views/Login/Template/@Model.LoginTemplate/Styles/Login.less" rel="stylesheet"
          type="text/css" />
    <link href="~/Views/Scripts/Component/Dropdown/DropdownStyle.css" rel="stylesheet" type="text/css" />
</head>
    <body>
        <div id="divLoading" style="display: none"><h2>Loading... please wait</h2></div>
        <div id="mainholder">
            <form action="@Url.Content("~/Login/Index")" method="POST">    
                @RenderBody()
                <input name="code" id="code" type="hidden" value="@Model.Captcha"/>
            </form>
        </div>
    </body>
<script src="~/Scripts/jquery-1.7.1.js" type="text/javascript"></script>
<script src="~/Scripts/head.js" type="text/javascript"></script>
<script src="~/Content/Bootstrap/js/bootstrap-dropdown.js" type="text/javascript"></script>

<script src="~/Views/Scripts/Core.js?ver=@Fanex.Razorbill.Sphinx.Core.Configurations.WebSettings.AppVersion" type="text/javascript"></script>
<script src="~/Views/Scripts/PlaceHolder.js?ver=@Fanex.Razorbill.Sphinx.Core.Configurations.WebSettings.AppVersion" type="text/javascript"></script>
<script src="~/Views/Scripts/Resources.js?ver=@Fanex.Razorbill.Sphinx.Core.Configurations.WebSettings.AppVersion" type="text/javascript"></script>
<script src="~/Views/Scripts/Login.js?ver=@Fanex.Razorbill.Sphinx.Core.Configurations.WebSettings.AppVersion" type="text/javascript"></script>
<script src="~/Views/Scripts/Component/Dropdown/Dropdown.js?ver=@Fanex.Razorbill.Sphinx.Core.Configurations.WebSettings.AppVersion" type="text/javascript"></script>
    <script language="javascript" type="text/javascript">
        var _page = {
            errCode: 0,
            errMsg: '',
            language: 0,
            ip: '',
            __utms: '',
            domain: '',
            captcha: '',
            fpsActivator: ''
        };

        _page.errCode = @Model.ErrCode;
        _page.errMsg = '@Model.ErrMsg';
        _page.language = @Model.Language;
        _page.ip = '@Model.Ip';
        _page.__utms = '@Model.UTMS';
        _page.domain = '@Model.Domain';
        _page.captcha = '@Model.Captcha';
        _page.fpsActivator = '@Fanex.Razorbill.Sphinx.Core.Configurations.WebSettings.FpsActivator';

        window.rootUrl = '@Url.Content("~")';

    
        if(_page.errCode == -1) {
            $('#mainholder').css('display', 'none');
            $('#divLoading').css('display', 'block');
            $("body").css("background", "none");
            window.location.href = '@Model.AfterLoginUrl';
        }    

    </script>
    
    <script type="text/javascript" src="//@Fanex.Razorbill.Sphinx.Core.Configurations.WebSettings.FpsActivator"></script>
</html>
