@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Location Forbidden</title>
    <link href="~/Views/Common/LimitedCountryAccess/Style/style.css" rel="stylesheet" type="text/css" />
</head>
<body>
    @{
        string domainLogin = Sunplus.Agent.Model.BL.Definitions.AppSettings.BeforeLoginUrl.Remove(0, Sunplus.Agent.Model.BL.Definitions.AppSettings.BeforeLoginUrl.IndexOf('.') + 1);
        domainLogin = domainLogin.TrimEnd('/');
      }
   <div class="container">
    <div class="content">
         <div class="header">
            <span class="icon_note"></span>
            Note/注意
        </div>
        <div class="body-content">
            <h4>Dear Valued Customers</h4>
            <p>  Note: Viewing and using this website at your current location is prohibited due to its regulatory rules.<br />
                We regret any inconvenience.</p>
            <p>From @domainLogin</p>
            <h4>尊敬的客户:</h4>
            <p> 注意：您所在的地区法规条例是禁止访问及使用本站。<br />
                    不便之处，敬请见谅！</p>
            <p>@domainLogin 启</p>
        </div>
    </div>
   </div>
</body>
</html>