        <div id="errmsg" class="errmsg error">
            &nbsp;
        </div>
        <div class="tdBlank">
        </div>
        <div class="tdRefresh">
        </div>
        <div class="languageBox">
            <span id="spnLanguage" class="language hidden"></span>
            <select id="selLanguage" onchange="SelectLanguage(this.value)">
                <option class="engLishLanguage" value="0">English</option>
                <option class="taiwanLanguage" value="1">繁體中文</option>
                <option class="chinaLanguage" value="4">简体中文</option>
                <option class="japanLanguage" value="2">日本語</option>
                <option class="thaiLanguage" value="3">ภาษาไทย</option>
                <option class="koreaLanguage" value="5">한국어</option>
                <option class="vietNamLanguage" value="6">Tiếng Việt</option>
            </select>
            <input type="hidden" value="en-US" id="hidLanguage" name="hidLanguage" />
        </div>
        <div class="box">
            <span id="spnUserName" class="hidden">Username</span>
            <input id="txtUserName" name="txtUserName" type="text" placeholder="Username" value="{username_value}" />
        </div>
        <div class="box">
            <span id="spnPassWord" class="hidden">Password</span>
            <input id="txtPassWord" class="tb placeholder" name="txtPassWord" placeholder="Password"
                type="password" />
        </div>
        <div class="verbox">
            <input id="txtCaptcha" class="tb input2" name="txtCaptcha" type="text" maxlength="4"
                autocomplete="off" onkeydown="DoEnter(event, 'DoLogin()')" class="txbCaptchcha" />
        </div>
        <div class="capcha" alt="">
            <img id="imgCode" src="../../Handlers/Captcha.ashx" onclick="GetValidateImage()"
                alt="Refresh" title="Refresh" />
        </div>
        <div class="clear">
        </div>
